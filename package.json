{
  "name": "trazflow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/test-server-only.mjs --test \"src/**/*.test.ts\"",
    "test:unit": "vitest run",
    "test:coverage": "c8 npm test",
    "test:backend": "npm test && npm run test:unit",
    "test:coverage:unit": "vitest run --coverage",
    "test:all": "npm test && npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:demo": "playwright test tests/e2e/driver-delivery.spec.ts --config=playwright.demo.config.ts --headed --workers=1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@zxing/browser": "^0.2.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

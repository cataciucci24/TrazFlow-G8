{
  "name": "trazflow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage",
    "test:all": "npm test && npm run test:e2e",
    "test:e2e": "playwright test --project=e2e",
    "test:demo": "playwright test --project=demo --headed --workers=1",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e:forecast": "playwright test --project=forecast",
    "test:e2e:plan-changes": "playwright test --project=plan-changes",
    "test:e2e:stock-import": "playwright test --project=stock-import",
    "test:e2e:stock-import-erp": "playwright test --project=stock-import-erp",
    "test:e2e:subscription": "playwright test --project=subscription"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

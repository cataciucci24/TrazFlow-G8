# Copiá este archivo a .env.local y completá los valores. Nunca subas claves reales.

# Supabase (públicas: las usa también el navegador; la seguridad la da RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ERP: solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Sin ERP_PROVIDER la empresa trabaja sin ERP (alta manual de productos, lotes y pallets).
# Con ERP_PROVIDER definido se habilita la sincronización y se oculta el alta manual de productos, lotes y órdenes;
# los pallets físicos se arman contra lotes del ERP sin superar su saldo (TRZ-100).
# Para ver el flujo con datos de prueba: ERP_PROVIDER=mock
ERP_PROVIDER=
# Solo mock: ok | timeout | unauthorized | validation | server_error
ERP_MOCK_SCENARIO=ok
# Solo mock: estado del remito que informa getDispatchStatus (TRZ-100). confirmed (por defecto) simula que
# administración confirma enseguida; draft deja el remito en borrador, para probar que lo despachado sigue
# contando contra el saldo (no vuelve al disponible de "Armar pallet") hasta que el remito se confirma.
ERP_MOCK_DISPATCH_STATUS=confirmed
# Solo erpnext
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=
# Opcional (ms)
ERP_TIMEOUT_MS=10000
# Panel de integración: horas sin una sincronización exitosa antes de marcarla "Desactualizada" (24 por defecto)
ERP_SYNC_STALE_AFTER_HOURS=24

# Tareas programadas (TRZ-104): solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Clave secret / service_role de Supabase (Project Settings → API Keys). Salta la RLS: solo la usan los
# Route Handlers de /api/cron para enviar los reportes pendientes al ERP y sincronizar sin usuario.
# En local: el SECRET_KEY o SERVICE_ROLE_KEY que muestra `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto que tiene que mandar quien llama a /api/cron/* en el header `Authorization: Bearer <CRON_SECRET>`
# (pg_cron en Supabase, ver docs/erp-integration-panel.md). Mínimo 16 caracteres; sin él los cron responden 401.
# Generarlo con: openssl rand -hex 32
CRON_SECRET=

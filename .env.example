# Copiá este archivo a .env.local y completá los valores. Nunca subas claves reales.

# Supabase (públicas: las usa también el navegador; la seguridad la da RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ERP (TRZ-112): cada empresa configura su ERP en Integración ERP → "Configuración del ERP" (credenciales cifradas
# en Supabase Vault). Las variables ERP_* de abajo son SOLO de transición: valen únicamente para la empresa de
# ERP_ENV_COMPANY_ID y solo mientras esa empresa no tenga una configuración guardada en el panel (la guardada gana).
# Sin ERP, la empresa trabaja en modo manual (alta de productos, lotes y pallets en TrazFlow).
# Solo servidor, nunca con prefijo NEXT_PUBLIC_.
# En local, la empresa del seed es TrazFlow Demo: 5eed0000-0000-0000-0000-000000000001
ERP_ENV_COMPANY_ID=
# Para ver el flujo con datos de prueba: ERP_PROVIDER=mock (o elegir "ERP simulado" en el panel)
ERP_PROVIDER=
# Solo mock: ok | timeout | unauthorized | validation | server_error
ERP_MOCK_SCENARIO=ok
# Solo mock: estado del remito que informa getDispatchStatus (TRZ-100). confirmed (por defecto) simula que
# administración confirma enseguida; draft deja el remito en borrador, para probar que lo despachado sigue
# contando contra el saldo (no vuelve al disponible de "Armar pallet") hasta que el remito se confirma.
ERP_MOCK_DISPATCH_STATUS=confirmed
# erpnext y odoo: raíz de la instancia (p. ej. http://localhost:8080 o http://localhost:8069)
ERP_BASE_URL=
# erpnext: API key y secret del usuario técnico. odoo: API key del usuario (Preferencias → Seguridad de la cuenta)
ERP_API_KEY=
# Solo erpnext
ERP_API_SECRET=
# Solo odoo: base de datos y usuario (login) dueño de la API key
ERP_ODOO_DB=
ERP_ODOO_USER=
# Opcional (ms)
ERP_TIMEOUT_MS=10000
# Opcional: Item Group de los productos que crea la importación de stock. Sin valor, el primero que no sea grupo.
ERP_ITEM_GROUP=
# Panel de integración: horas sin una sincronización exitosa antes de marcarla "Desactualizada" (24 por defecto)
ERP_SYNC_STALE_AFTER_HOURS=24

# Tareas programadas (TRZ-104): solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Clave secret / service_role de Supabase (Project Settings → API Keys). Salta la RLS: solo la usan los
# Route Handlers de /api/cron para enviar los reportes pendientes al ERP y sincronizar sin usuario.
# TRZ-112: también la usa el servidor para leer las credenciales del ERP de cada empresa (erp_company_connection).
# En local: el SECRET_KEY o SERVICE_ROLE_KEY que muestra `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto que tiene que mandar quien llama a /api/cron/* en el header `Authorization: Bearer <CRON_SECRET>`
# (pg_cron en Supabase, ver docs/erp-integration-panel.md). Mínimo 16 caracteres; sin él los cron responden 401.
# Generarlo con: openssl rand -hex 32
CRON_SECRET=
